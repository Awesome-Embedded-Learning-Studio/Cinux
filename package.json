{
  "name": "cinux-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm docs:notes && pnpm docs:api && vitepress dev site",
    "build": "tsx scripts/build.ts",
    "build:single": "vitepress build site",
    "preview": "pnpm build:single && vitepress preview site",
    "check:links": "tsx scripts/check-links.ts",
    "docs:api": "tsx site/api-gen/src/generate-groups.ts && if command -v doxygen >/dev/null 2>&1; then doxygen site/api-gen/Doxyfile && tsx site/api-gen/src/cli.ts; else echo 'doxygen 未安装,跳过 API 数据生成'; fi",
    "test:api": "vitest run --root site/api-gen",
    "docs:notes": "tsx scripts/gen-notes-index.ts",
    "preview:dist": "vitepress preview site",
    "typecheck:api": "tsc --noEmit -p site/api-gen/tsconfig.json"
  },
  "devDependencies": {
    "@dhlx/vitepress-plugin-drawio": "^0.0.10",
    "@panzoom/panzoom": "^4.6.2",
    "@types/node": "^22.15.0",
    "@vueuse/core": "^12.8.2",
    "@vueuse/integrations": "^12.8.2",
    "fast-xml-parser": "^5.12.0",
    "gray-matter": "4.0.3",
    "linkedom": "0.18.13",
    "mark.js": "8.11.1",
    "markdown-it": "^15.0.2",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^10.9.6",
    "shiki": "^2.5.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.34"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
