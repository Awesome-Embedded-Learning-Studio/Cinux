BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABIHF=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y
# The armv7 loader maps user images inside [0x40000000, 0x80000000); the
# arm default link address (0x10000) sits in the kernel's identity range
# and is refused, so every target binary links into the window's foot.
BR2_TARGET_LDFLAGS="-Wl,-Ttext-segment=0x40010000"
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
# BR2_ROOTFS_MERGED_USR is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DHCP=""
BR2_TARGET_GENERIC_HOSTNAME="cinux"
BR2_TARGET_GENERIC_ISSUE="Cinux development environment"
BR2_PACKAGE_BUSYBOX=y
BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_LINUX_KERNEL is not set
BR2_PACKAGE_BUSYBOX_CONFIG="@CINUX_BUSYBOX_CONFIG@"
BR2_ROOTFS_OVERLAY="@CINUX_NATIVE_OVERLAY@"
BR2_ROOTFS_USERS_TABLES="@CINUX_USERS_TABLE@"
