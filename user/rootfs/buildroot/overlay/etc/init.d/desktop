#!/bin/sh
if [ "${CINUX_SESSION:-}" = gui ]; then
    # su's login environment is fresh; set tracing inside it so the GUI
    # checks can observe input and PTY activity on the serial console.
    exec /bin/su - cinux -c 'export VESPER_FBDEV_TRACE=1; exec /bin/vesper /dev/fb0 /dev/event0 /dev/event1'
fi
